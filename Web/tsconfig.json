{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vitest/globals"], "noEmit": true,
    "paths": { "@/*": ["./src/*"], "@@/*": ["./*"], "#imports": ["./src/shim/imports.ts"] }
  },
  "include": ["src", "tests"]
}
