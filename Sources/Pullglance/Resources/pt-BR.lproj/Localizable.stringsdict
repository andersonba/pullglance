  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@prs@</string>
    <key>prs</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>%lld pull request voltou para a sua seção</string>
      <key>other</key>
      <string>%lld pull requests voltaram para as suas seções</string>
    </dict>
  </dict>
