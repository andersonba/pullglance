<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>%lld open threads</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@threads@</string>
    <key>threads</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>%lld thread aberta</string>
      <key>other</key>
      <string>%lld threads abertas</string>
    </dict>
  </dict>
  <key>%lld files</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@files@</string>
    <key>files</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>%lld arquivo</string>
      <key>other</key>
      <string>%lld arquivos</string>
    </dict>
  </dict>
  <key>Branch kept: %lld open pull requests are based on it</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@prs@</string>
    <key>prs</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>Branch mantida: %lld pull request aberto é baseado nela</string>
      <key>other</key>
      <string>Branch mantida: %lld pull requests abertos são baseados nela</string>
    </dict>
  </dict>
  <key>%lld repos</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@repos@</string>
    <key>repos</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>%lld repo</string>
      <key>other</key>
      <string>%lld repos</string>
    </dict>
  </dict>
  <key>Quick · %lld files</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@files@</string>
    <key>files</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>Rápido · %lld arquivo</string>
      <key>other</key>
      <string>Rápido · %lld arquivos</string>
    </dict>
  </dict>
